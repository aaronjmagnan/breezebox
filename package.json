{
  "name": "breezebox",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:start": "pnpm --filter @breezebox/db start",
    "db:stop": "pnpm --filter @breezebox/db stop",
    "db:reset": "pnpm --filter @breezebox/db reset",
    "db:diff": "pnpm --filter @breezebox/db diff",
    "db:push": "pnpm --filter @breezebox/db push",
    "db:types": "pnpm --filter @breezebox/db types"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.11"
  }
}
