# Breeze Box :: copy to .env.local and fill in.
# Never commit .env.local.

# --- Supabase --------------------------------------------------------------
# `pnpm db:start` prints these for the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# The browser-safe key. Supabase calls this the "anon key" on older projects
# and the "publishable key" on newer ones; either variable name works:
#   NEXT_PUBLIC_SUPABASE_ANON_KEY
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS, so it never goes in a NEXT_PUBLIC_ var and never
# reaches the browser. The shell does not need it; the admin app will.
SUPABASE_SERVICE_ROLE_KEY=

# Only needed for `pnpm --filter @breezebox/db types:remote` and `db:push`.
SUPABASE_PROJECT_ID=

# --- Hostname routing (§8) -------------------------------------------------
# No root domain setting: the whole hostname is handed to
# get_district_branding(), which does the matching in Postgres. So the app
# works on localhost, a preview URL, the wildcard and a custom domain with no
# configuration at all.
#
# The exception is a hostname that carries no district slug of its own -- a
# bare localhost:3000, or a *.vercel.app preview. This names the district
# those fall back to.
#
# REMOVE THIS FROM PRODUCTION once a wildcard domain resolves real district
# hostnames. Left on, it turns "district not found" into quietly serving this
# district, so a typo'd subdomain would show someone else's app. The shell
# logs a warning every time it fires in production.
NEXT_PUBLIC_DEFAULT_DISTRICT_SLUG=demo

# --- OAuth providers (§5) --------------------------------------------------
# Read by packages/db/supabase/config.toml for the local stack. In production
# these are configured in the Supabase dashboard, not here.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_AZURE_CLIENT_ID=
SUPABASE_AUTH_AZURE_SECRET=
SUPABASE_AUTH_AZURE_URL=https://login.microsoftonline.com/common/v2.0

# --- Tool zones (§2) -------------------------------------------------------
# One origin per registered tool, matching apps/shell/src/config/tool-zones.mjs.
# Set these on the SHELL project, per environment: point preview at the tool's
# preview URL and production at production, or preview traffic proxies into
# production data.
#
# Locally: run the tool with `pnpm --filter @breezebox/tool-learning-cycles dev`
# (port 3001) and reach it through the shell at
# http://demo.localhost:3000/learning-cycles -- not port 3001 directly, or the
# session cookie is on the wrong origin and you will look signed out.
TOOL_LEARNING_CYCLES_ORIGIN=http://localhost:3001

# Ed Code Assistant. Run it with
# `pnpm --filter @breezebox/tool-ed-code dev` (port 3002) and reach it at
# http://demo.localhost:3000/ed-code.
TOOL_ED_CODE_ORIGIN=http://localhost:3002

# --- Ed Code Assistant -----------------------------------------------------
# Server-only, and set on the TOOL's Vercel project rather than the shell's.
# No NEXT_PUBLIC_ prefix: that would inline the key into the browser bundle.
ANTHROPIC_API_KEY=

# Optional overrides. Left unset, the tool uses Haiku 4.5 to turn a question
# into search terms and Sonnet 5 to write the answer from the passages.
# ED_CODE_PLAN_MODEL=
# ED_CODE_ANSWER_MODEL=

# --- Loading the legal library ---------------------------------------------
# The ingest CLI needs SUPABASE_SERVICE_ROLE_KEY (above) and SUPABASE_URL.
# Run it from a laptop, never from a deployment:
#
#   pnpm --filter @breezebox/tool-ed-code ingest ed-code --dry-run --limit 5
#
# See apps/tool-ed-code/README.md. Always dry run first.
