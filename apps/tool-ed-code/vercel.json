{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "ignoreCommand": "npx --yes turbo-ignore @breezebox/tool-ed-code",
  "github": { "silent": true },
  "redirects": [
    {
      "source": "/",
      "destination": "/ed-code",
      "permanent": false
    }
  ]
}
